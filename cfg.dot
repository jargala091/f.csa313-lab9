// scholarship() функцийн Control Flow Graph.
// Үүсгэх: dot -Tpng -Gdpi=150 cfg.dot -o cfg.png
// Ирмэг бүр дээр түүнийг дайрдаг тестийн (ScholarshipCalculatorTest) методын нэрийг бичсэн.
digraph scholarship_CFG {
  rankdir=TB;
  nodesep=0.5; ranksep=0.7;
  node [shape=box, fontname="DejaVu Sans", fontsize=11, style=filled, fillcolor="#eef3fb"];
  edge [fontname="DejaVu Sans", fontsize=9];

  Start [shape=ellipse, fillcolor="#d7f0d7", label="scholarship(gpa, credits, hasViolation)"];

  N1  [label="N1: gpa<0 || gpa>4 || credits<0 ?", shape=diamond, fillcolor="#fff2cc"];
  Throw [label="throw IllegalArgumentException", fillcolor="#f8cecc"];

  N2  [label="N2: hasViolation ?", shape=diamond, fillcolor="#fff2cc"];
  Ret0a [label="return 0", fillcolor="#d7f0d7"];

  N3a [label="N3a: gpa>=3.8 ?", shape=diamond, fillcolor="#fff2cc"];
  N3b [label="N3b: credits>=15 ?", shape=diamond, fillcolor="#fff2cc"];
  Ret100 [label="return 100", fillcolor="#d7f0d7"];

  N4a [label="N4a: gpa>=3.4 ?", shape=diamond, fillcolor="#fff2cc"];
  N4b [label="N4b: credits>=12 ?", shape=diamond, fillcolor="#fff2cc"];
  Ret70 [label="return 70", fillcolor="#d7f0d7"];

  N5  [label="N5: gpa>=3.0 ?", shape=diamond, fillcolor="#fff2cc"];
  Ret50 [label="return 50", fillcolor="#d7f0d7"];
  Ret0b [label="return 0", fillcolor="#d7f0d7"];

  Start -> N1 [label="бүх 10 тест эндээс эхэлнэ"];

  N1 -> Throw [color="#cc0000", fontcolor="#cc0000",
    label="T\lscholarship_gpa_sul_hyazgaaraas_gadna_exception\lscholarship_gpa_deed_hyazgaaraas_gadna_exception\lscholarship_credits_sul_hyazgaaraas_gadna_exception\l"];
  N1 -> N2 [label="F\lscholarship_olon_tetgelegt_100_butsna\lscholarship_golch_hangasan_bol_50_butsna\lscholarship_zorchiltoi_bol_tetgeleggui\lscholarship_gpa38_credits_dutuu_50_butsna\lscholarship_gpa34_credits12_70_butsna\lscholarship_gpa34_dooshoo_50_butsna\lscholarship_gpa30_dooshoo_0_butsna\l"];

  N2 -> Ret0a [label="T\lscholarship_zorchiltoi_bol_tetgeleggui\l"];
  N2 -> N3a [label="F\lscholarship_olon_tetgelegt_100_butsna\lscholarship_golch_hangasan_bol_50_butsna\lscholarship_gpa38_credits_dutuu_50_butsna\lscholarship_gpa34_credits12_70_butsna\lscholarship_gpa34_dooshoo_50_butsna\lscholarship_gpa30_dooshoo_0_butsna\l"];

  N3a -> N3b [label="T (gpa>=3.8)\lscholarship_olon_tetgelegt_100_butsna\lscholarship_gpa38_credits_dutuu_50_butsna\l"];
  N3a -> N4a [label="F (gpa<3.8)\lscholarship_golch_hangasan_bol_50_butsna\lscholarship_gpa34_credits12_70_butsna\lscholarship_gpa34_dooshoo_50_butsna\lscholarship_gpa30_dooshoo_0_butsna\l"];

  N3b -> Ret100 [label="T (credits>=15)\lscholarship_olon_tetgelegt_100_butsna\l"];
  N3b -> N4a [label="F (credits<15)\lscholarship_gpa38_credits_dutuu_50_butsna\l"];

  N4a -> N4b [label="T (gpa>=3.4)\lscholarship_gpa38_credits_dutuu_50_butsna\lscholarship_gpa34_credits12_70_butsna\l"];
  N4a -> N5 [label="F (gpa<3.4)\lscholarship_golch_hangasan_bol_50_butsna\lscholarship_gpa34_dooshoo_50_butsna\lscholarship_gpa30_dooshoo_0_butsna\l"];

  N4b -> Ret70 [label="T (credits>=12)\lscholarship_gpa34_credits12_70_butsna\l"];
  N4b -> N5 [label="F (credits<12)\lscholarship_gpa38_credits_dutuu_50_butsna\l"];

  N5 -> Ret50 [label="T (gpa>=3.0)\lscholarship_golch_hangasan_bol_50_butsna\lscholarship_gpa38_credits_dutuu_50_butsna\lscholarship_gpa34_dooshoo_50_butsna\l"];
  N5 -> Ret0b [label="F (gpa<3.0)\lscholarship_gpa30_dooshoo_0_butsna\l"];
}
